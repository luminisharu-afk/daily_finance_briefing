<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ report["title"] }}</title>
  <style>
    :root {
      color-scheme: light;
      --text: #303030;
      --muted: #747474;
      --rule: #acacac;
      --line: #d9d9d9;
      --soft-line: #ededed;
      --panel: #fafafa;
      --up: #cf625e;
      --down: #4c94b3;
      --flat: #727272;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans KR", sans-serif;
    }

    body {
      margin: 0;
      background: #ffffff;
      color: var(--text);
    }

    .report {
      width: min(650px, calc(100vw - 40px));
      margin: 28px auto 44px;
    }

    h1 {
      margin: 0 0 34px;
      font-size: 32px;
      line-height: 1.15;
      font-weight: 800;
      letter-spacing: 0;
    }

    .market-section {
      margin-top: 34px;
    }

    h2 {
      margin: 0 0 11px;
      font-size: 25px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: 0;
    }

    .market-table {
      border-top: 2px solid var(--rule);
      border-bottom: 1px solid var(--line);
      overflow: hidden;
    }

    .market-table.grid {
      display: grid;
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    }

    .market-item {
      min-width: 0;
    }

    .market-table.grid .market-item {
      display: grid;
      grid-template-rows: 58px 60px;
      border-right: 1px solid var(--soft-line);
      border-bottom: 1px solid var(--soft-line);
    }

    .market-table.grid.columns-2 .market-item:nth-child(2n) {
      border-right: 0;
    }

    .market-table.grid.columns-2 .market-item:nth-last-child(-n + 2) {
      border-bottom: 0;
    }

    .market-name {
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--panel);
      color: var(--text);
      font-size: 22px;
      font-weight: 800;
      text-align: center;
      word-break: keep-all;
      line-height: 1.25;
    }

    .market-table.grid .market-name {
      padding: 0 12px;
      border-bottom: 1px solid var(--soft-line);
    }

    .market-value {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: var(--flat);
      font-size: 18px;
      font-weight: 800;
      text-align: center;
      white-space: normal;
      line-height: 1.25;
    }

    .market-value.up {
      color: var(--up);
    }

    .market-value.down {
      color: var(--down);
    }

    .value {
      font-size: 20px;
    }

    .market-table.list .market-item {
      display: grid;
      grid-template-columns: minmax(110px, 31%) minmax(0, 1fr);
      min-height: 60px;
      border-bottom: 1px solid var(--soft-line);
    }

    .market-table.list .market-item:last-child {
      border-bottom: 0;
    }

    .market-table.list .market-name {
      padding: 0 12px;
      border-right: 1px solid var(--soft-line);
    }

    .market-table.list .market-value {
      justify-content: flex-start;
      padding: 0 0 0 34px;
    }

    .missing {
      color: var(--muted);
      font-size: 16px;
      font-weight: 700;
    }

    @media (max-width: 520px) {
      .report {
        width: calc(100vw - 28px);
        margin-top: 22px;
      }

      h1 {
        margin-bottom: 30px;
        font-size: 30px;
      }

      h2 {
        font-size: 24px;
      }

      .market-name {
        font-size: 19px;
      }

      .market-value {
        font-size: 16px;
      }

      .value {
        font-size: 17px;
      }

      .market-table.grid .market-item {
        grid-template-rows: 54px 56px;
      }

      .market-table.list .market-item {
        grid-template-columns: minmax(96px, 31%) minmax(0, 1fr);
        min-height: 56px;
      }

      .market-table.list .market-value {
        padding-left: 24px;
      }
    }
  </style>
</head>
<body>
  <main class="report">
    <h1>{{ report["title"] }}</h1>

    {% for section in report["sections"] %}
    <section class="market-section" aria-labelledby="section-{{ loop.index }}">
      <h2 id="section-{{ loop.index }}">{{ section["name"] }}</h2>
      <div class="market-table {% if section["columns"] == 1 %}list{% else %}grid columns-{{ section["columns"] }}{% endif %}" style="--columns: {{ section["columns"] }}">
        {% for item in section["items"] %}
        <article class="market-item" title="{{ item["symbol"] }}{% if item["trade_date"] %} · {{ item["trade_date"] }}{% endif %}">
          <div class="market-name">{{ item["label"] }}</div>
          <div class="market-value {{ item["direction"] }}">
            {% if item["status"] == "ok" %}
            <span class="value">{{ item["value_text"] }}</span>
            <span aria-hidden="true">{{ item["arrow"] }}</span>
            <span>{{ item["percent_text"] }}</span>
            {% else %}
            <span class="missing">데이터 없음</span>
            {% endif %}
          </div>
        </article>
        {% endfor %}
      </div>
    </section>
    {% endfor %}
  </main>
</body>
</html>
